{
  "manifest_version": 3,
  "name": "Argus Capture",
  "version": "0.1.0",
  "description": "Capture the current job posting into your local Argus backend.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "options_page": "options.html",
  "externally_connectable": {
    "ids": [],
    "matches": []
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:8000"
  }
}
