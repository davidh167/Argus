POSTGRES_USER=argus
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=argus
POSTGRES_PORT=5432

# Must match the POSTGRES_* values above (user, password, database, port); it is not derived from them.
DATABASE_URL=postgresql+psycopg://argus:devpassword@localhost:5432/argus
ANTHROPIC_API_KEY=

# generate with: poetry run python scripts/generate_api_token.py
API_TOKEN=

# Optional: Docker volume holding the Postgres data. Defaults to argus_pgdata; set this to reuse an
# existing volume instead of starting with an empty database.
# PGDATA_VOLUME=argus_pgdata

# Embeddings run in-process through the native core by default (EMBEDDINGS_BACKEND=native): build it with
#   cmake -S native -B native/build-release -G Ninja && cmake --build native/build-release
# and download the model (274 MB) with `python3 native/tools/fetch_model.py`. There is no automatic fallback:
# a missing library or model is an error that names the command to run. To use a local Ollama server
# instead, uncomment the next line.
# EMBEDDINGS_BACKEND=ollama
# Optional overrides of the native defaults (the fetch_model.py download dir, native/build-release, and an
# index file next to the model dir that keeps phrase vectors across restarts):
# ARGUS_MODEL_PATH=
# ARGUS_LIB_PATH=
# ARGUS_INDEX_PATH=
